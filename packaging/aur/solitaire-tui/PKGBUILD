# Maintainer: Jonas Forsbakk <jonas@forsbakk.priv.no>

pkgname=solitaire-tui
pkgver=0.2.0
pkgrel=1
pkgdesc='Seven solitaire games in the terminal, built with ratatui'
arch=('x86_64' 'aarch64')
url='https://github.com/Forsbakk/solitaire-tui'
license=('MIT OR Apache-2.0')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Regenerate after tagging: makepkg -g -p packaging/aur/solitaire-tui/PKGBUILD
sha256sums=('4016b69d4ef0367d22c9c81ba4597ecccef2164b8facae536ad7b6c3228bbcaf')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --all-features
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --all-features
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm0755 -t "$pkgdir/usr/bin/" target/release/solitaire-tui
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE-MIT LICENSE-APACHE
  install -Dm0644 -t "$pkgdir/usr/share/doc/$pkgname/" README.md
}
